# ─── Resend (email) ───────────────────────────────────────────────
# Get your key at resend.com → API Keys
RESEND_API_KEY=<your-resend-api-key>

# Optional: Resend Audience ID for newsletter list (Resend → Audiences)
RESEND_AUDIENCE_ID=

# Email that receives form submissions
CONTACT_EMAIL=contato@paxbrasiliana.com

# "From" address — must be a domain you've verified in Resend
FROM_EMAIL=noreply@paxbrasiliana.com

# ─── Stripe (payments) ────────────────────────────────────────────
# Get your keys at dashboard.stripe.com → Developers → API keys
STRIPE_SECRET_KEY=<your-stripe-secret-key>
STRIPE_PUBLISHABLE_KEY=<your-stripe-publishable-key>

# Webhook secret — from Stripe CLI: `stripe listen --forward-to localhost:3000/api/webhook`
# Or from Stripe Dashboard → Webhooks → your endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=<your-stripe-webhook-secret>

# ─── Site URL ─────────────────────────────────────────────────────
# Used for Stripe success/cancel redirect URLs
NEXT_PUBLIC_SITE_URL=https://paxbrasiliana.com

# ─── Resend (email) ───────────────────────────────────────────────
# Get your key at resend.com → API Keys
RESEND_API_KEY=<your-resend-api-key>

# Optional: Resend Audience ID for newsletter list (Resend → Audiences)
RESEND_AUDIENCE_ID=

# Email that receives form submissions
CONTACT_EMAIL=contato@paxbrasiliana.com

# "From" address — must be a domain you've verified in Resend
FROM_EMAIL=noreply@paxbrasiliana.com

# ─── Stripe (payments) ────────────────────────────────────────────
# Get your keys at dashboard.stripe.com → Developers → API keys
STRIPE_SECRET_KEY=<your-stripe-secret-key>
STRIPE_PUBLISHABLE_KEY=<your-stripe-publishable-key>

# Webhook secret — from Stripe CLI: `stripe listen --forward-to localhost:3000/api/webhook`
# Or from Stripe Dashboard → Webhooks → your endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=<your-stripe-webhook-secret>

# ─── Melhor Envio (cálculo de frete na loja) ──────────────────────
# Setup (uma vez):
# 1. melhorenvio.com.br → Integrações → Área Dev → Cadastrar aplicativo.
#    Redirect URI: http://localhost:3000/api/shipping/oauth/callback
#    Escopo: shipping-calculate
# 2. Cole o Client ID / Client Secret abaixo.
# 3. Com `npx next dev` rodando, acesse no browser:
#    http://localhost:3000/api/shipping/oauth/start
#    Autorize e copie MELHOR_ENVIO_TOKEN / MELHOR_ENVIO_REFRESH_TOKEN da página de callback.
MELHOR_ENVIO_CLIENT_ID=<your-melhor-envio-client-id>
MELHOR_ENVIO_CLIENT_SECRET=<your-melhor-envio-client-secret>
MELHOR_ENVIO_REDIRECT_URI=http://localhost:3000/api/shipping/oauth/callback
MELHOR_ENVIO_TOKEN=<your-melhor-envio-access-token>
MELHOR_ENVIO_REFRESH_TOKEN=<your-melhor-envio-refresh-token>

# "true" pra usar a API sandbox (sandbox.melhorenvio.com.br) com um app/token de
# sandbox separado. Deixe "false" (ou remova) em produção.
MELHOR_ENVIO_SANDBOX=false

# CEP de origem dos envios (de onde o merch é despachado).
MELHOR_ENVIO_FROM_CEP=03182040

# ─── Site URL ─────────────────────────────────────────────────────
# Used for Stripe success/cancel redirect URLs
NEXT_PUBLIC_SITE_URL=https://paxbrasiliana.com

# ─── brapi.dev (Rastreador B3 — cotações ao vivo) ─────────────────
# Token gratuito em brapi.dev → Dashboard. Sem token funciona, mas com
# rate-limit baixo (cai pro Yahoo Finance). Com token: market cap + batch.
BRAPI_TOKEN=<your-brapi-token>

# ─── Supabase (Cadeia Produtiva — índice + contribuições) ─────────
# Crie um projeto em supabase.com → Project Settings → API.
# Rode supabase/schema.sql uma vez no SQL editor, depois:
#   npx tsx scripts/seed-fabricantes.ts   (popula a tabela fabricantes)
# Sem estas vars, a Cadeia usa o dataset estático (src/data/fabricantes.ts).
NEXT_PUBLIC_SUPABASE_URL=<https://xxxx.supabase.co>
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-anon-public-key>
# Service role: SOMENTE server-side (seed + moderação). Nunca exponha no client.
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>
